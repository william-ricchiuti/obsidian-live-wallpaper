{
  "name": "obsidian-live-wallpaper",
  "version": "1.2.0",
  "description": "Your Obsidian vault graph as a live desktop wallpaper",
  "author": "William Ricchiuti",
  "homepage": "https://github.com/william-ricchiuti/obsidian-live-wallpaper#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/william-ricchiuti/obsidian-live-wallpaper.git"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "config.example.json",
    "index.html",
    "settings.html",
    "parser.js",
    "worker.js",
    "renderer-core.js",
    "layout-core.js",
    "gl-renderer.js",
    "presets.json",
    "bin/cli.js",
    "lib/",
    "linux-setup.md",
    "macos-setup.md",
    "windows-setup.md",
    "vendor/",
    "themes/",
    "docs/presets/"
  ],
  "keywords": [
    "obsidian",
    "wallpaper",
    "graph",
    "desktop",
    "d3",
    "live-wallpaper"
  ],
  "main": "parser.js",
  "bin": {
    "obsidian-live-wallpaper": "bin/cli.js",
    "olw": "bin/cli.js"
  },
  "scripts": {
    "start": "node parser.js",
    "smoke": "node scripts/smoke.js && node scripts/smoke-install.js",
    "smoke:render": "node scripts/smoke-render.js",
    "test": "npm run smoke && npm run smoke:render",
    "lint": "eslint parser.js bin/cli.js lib/*.js obsidian-plugin/*.js worker.js renderer-core.js layout-core.js gl-renderer.js themes/*.js scripts/*.js eslint.config.js index.html settings.html",
    "lint:html": "eslint index.html settings.html",
    "prepublishOnly": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
